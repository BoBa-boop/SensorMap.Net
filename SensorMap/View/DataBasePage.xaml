<UserControl x:Class="SensorMap.View.DataBasePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:vm="clr-namespace:SensorMap.ViewModel"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SensorMap.View"
      mc:Ignorable="d" 
      xmlns:hc="https://handyorg.github.io/handycontrol"
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance vm:DataBasePageVM}">
    <UserControl.Resources>
        <Style x:Key="LogCellStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Error">
                    <Setter Property="Foreground" Value="#C62828"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Delete">
                    <Setter Property="Foreground" Value="#B26A00"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <GroupBox Style="{StaticResource GroupBoxOriginal}" Grid.Column="0"
          BorderThickness="1.5" Margin="8" BorderBrush="LightGray">
            <GroupBox.Header>
                <TextBlock Text="База данных" Style="{StaticResource TextBlockDefault}"
                   FontFamily="Bahnschrift" FontSize="17"/>
            </GroupBox.Header>
            <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Margin="10">
                <TextBlock Text="Загрузить новую БД"
                   HorizontalAlignment="Left"
                   Margin="0,5"
                   Style="{StaticResource TextBlockSubTitle}"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Name="txtDB_Name"
                       Text="{Binding DbName}"
                       Width="200"
                       Padding="7,5"
                       Background="WhiteSmoke"/>
                    <Button Width="35" Style="{StaticResource ButtonInfo}"
                    Cursor="Hand"
                    hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                    Command="{Binding ChangeDataBase}"/>
                </StackPanel>
                <Button Content="Расположение файла"
                        Cursor="Hand"
                        Margin="0,5"
                        HorizontalAlignment="Left"
                        Command="{Binding NavigateToPathDB}"/>

                <GroupBox Style="{StaticResource GroupBoxOriginalBaseStyle}"
                          HorizontalAlignment="Center"
                          BorderThickness="2" BorderBrush="{StaticResource BorderBrush}">
                <StackPanel Orientation="Vertical" 
                            Visibility="{Binding ElementName=stepBar,Path=Visibility}">
                <TextBlock Text="Проверка выбранного файла" Style="{StaticResource TextBlockSubTitle}" FontWeight="Medium"/>
                <hc:StepBar ItemsSource="{Binding Steps}"
                            Visibility="{Binding Steps.Count,Converter={StaticResource CountToReVisibility}}"
                            x:Name="stepBar"
                            StepIndex="{Binding StepIndex}"
                            Dock="Left" 
                            Foreground="{DynamicResource DangerBrush}"
                            Margin="10">
                    <hc:StepBar.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="14" HorizontalAlignment="Left"
                                           Text="{Binding Title}" FontWeight="Medium">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Foreground" Value="{StaticResource InfoBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="Ошибка">
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Ожидание">
                                                        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Успешно">
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </hc:StepBar.ItemTemplate>
                </hc:StepBar>
                
                <TextBlock Text="{Binding CheckError}"
                           Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap" FontSize="16" FontWeight="Bold"
                           Margin="0,10,0,0"/>
                </StackPanel>
                </GroupBox>
            </StackPanel>
        </GroupBox>
        <GroupBox Style="{StaticResource GroupBoxOriginal}"
                  Grid.Column="1" Margin="8">
            <GroupBox.Header>
                <TextBlock Text="Логи" Style="{StaticResource TextBlockDefault}"
                           FontFamily="Bahnschrift" FontSize="17"/>
            </GroupBox.Header>
            <Grid Grid.Column="1" Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>

                <!-- Поиск и фильтр -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
                    <hc:SearchBar Width="220"
                      hc:InfoElement.Placeholder="Поиск по журналу"
                      Text="{Binding LogSearch, UpdateSourceTrigger=PropertyChanged}"/>
                    <CheckBox Content="Только ошибки" Margin="10,0,0,0" VerticalAlignment="Center"
                  IsChecked="{Binding OnlyErrors}"/>
                </StackPanel>

                <DataGrid Name="SQL_Journal" Grid.Row="1"
              ItemsSource="{Binding LogsView}"
              SelectedItem="{Binding SelectedLog}"
              AutoGenerateColumns="False"
              IsReadOnly="True" VerticalScrollBarVisibility="Visible"
              Style="{StaticResource DataGrid.Small}">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Копировать" Command="{Binding CopyLog}"/>
                            <MenuItem Header="Показать полностью" Command="{Binding ShowFullLog}"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Дата"
                                Binding="{Binding Timestamp, StringFormat={}{0:dd.MM.yyyy HH:mm:ss}}"
                                Width="140" ElementStyle="{StaticResource LogCellStyle}"/>
                        <DataGridTextColumn Header="Действие" Binding="{Binding KindText}"
                                Width="95" ElementStyle="{StaticResource LogCellStyle}"/>
                        <DataGridTextColumn Header="Описание" Binding="{Binding Description}"
                                Width="*" ElementStyle="{StaticResource LogCellStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Button Content="Загрузить еще" Grid.Row="2"
            VerticalAlignment="Bottom"
            Command="{Binding LoadMoreLogs}"
            Visibility="{Binding CanLoadMore, Converter={StaticResource Bool2VisOrHidden}}"/>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
