<UserControl x:Class="SensorMap.View.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SensorMap.View"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             xmlns:System="clr-namespace:System;assembly=System.Runtime"
             xmlns:vm="clr-namespace:SensorMap.ViewModel"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance vm:SettingsVM}">
    <hc:TransitioningContentControl TransitionMode="Bottom2Top" Margin="10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel HorizontalAlignment="Left">
                <GroupBox Style="{StaticResource GroupBoxOriginal}"
                          BorderThickness="1.5" Margin="0,10,20,0" BorderBrush="LightGray">
                    <GroupBox.Header>
                        <TextBlock Text="Безопасность" Style="{StaticResource TextBlockDefault}"
                                   FontFamily="Bahnschrift" FontSize="17"/>
                    </GroupBox.Header>
                    <WrapPanel>
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="10">

                            <Button Width="auto" Style="{StaticResource ButtonInfo}"
                                    Cursor="Hand" Content="Создать коды восстановления"
                                    hc:IconElement.Geometry="{StaticResource AllGeometry}"
                                    Command="{Binding CreateRecoveryCodes}" />

                        </StackPanel>
                    </WrapPanel>
                </GroupBox>
                
                <GroupBox Style="{StaticResource GroupBoxOriginal}"
                          BorderThickness="1.5" Margin="0,10,20,0" BorderBrush="LightGray">
                    <GroupBox.Header>
                        <TextBlock Text="Главное меню" Style="{StaticResource TextBlockDefault}"
                                   FontFamily="Bahnschrift" FontSize="17"/>
                    </GroupBox.Header>
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Margin="10,0">
                        <TextBlock Text="Изображения в Меню" HorizontalAlignment="Left" Margin="0,5" Style="{StaticResource TextBlockSubTitle}"/>
                        <ListView ItemsSource="{Binding MySettings.MenuImages,UpdateSourceTrigger=PropertyChanged}"
                                  x:Name="lv"
                                  BorderThickness="0"
                                  AlternationCount="4"
                                  Background="Transparent"
                                  Style="{x:Null}">
                            <!-- Отключаем выделение и клики на уровне ListViewItem -->
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <hc:FlexPanel/>
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <hc:ImageSelector 
                    Height="70" Width="70"
                    ImageSelected="ImageSelector_ImageSelected"
                    Tag="{Binding (ItemsControl.AlternationIndex), 
                               RelativeSource={RelativeSource AncestorType=ListViewItem}}">
                                    </hc:ImageSelector>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
            
        </Grid>
    </hc:TransitioningContentControl>
</UserControl>
