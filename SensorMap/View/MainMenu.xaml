<UserControl x:Class="SensorMap.View.MainMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SensorMap.View"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:vm="clr-namespace:SensorMap.ViewModel"
             d:DataContext="{d:DesignInstance vm:MainMenuVM }"
             mc:Ignorable="d" >
    <hc:TransitioningContentControl TransitionMode="Fade">
        <Grid>
            <hc:Carousel x:Name="carousel" AutoRun="True" HorizontalAlignment="Center" Width="1200" Height="650"
                         ItemsSource="{Binding MySettings.MenuImages}">
                <hc:Carousel.ItemTemplate>
                    <DataTemplate>
                        <Image Source="{Binding }" Stretch="UniformToFill" Width="1200"/>
                    </DataTemplate>
                </hc:Carousel.ItemTemplate>
            </hc:Carousel>
        </Grid>
    </hc:TransitioningContentControl>
</UserControl>
