<hc:Window x:Class="SensorMap.View.MechanismSensorsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:valid="clr-namespace:SensorMap.Model.Validation"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SensorMap.View"
           xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
           xmlns:mv="clr-namespace:SensorMap.ViewModel"
        mc:Ignorable="d"
           xmlns:beh="clr-namespace:SensorMap.Behaviors"
           d:DataContext="{d:DesignInstance mv:MechSensorsVM}"
        Title="{Binding StringFormat=Датчики {0},Path=Mechanism.Name}"
           Height="450" Width="600" WindowStartupLocation="CenterScreen"
           Name="root">

    <Grid>
        <Grid.Resources>
            <Style x:Key="ValidatedCellStyle" TargetType="TextBox" BasedOn="{StaticResource DataGridEditingTextColumnStyle}">
                <Setter Property="MaxLength" Value="10"/>
                <Setter Property="MaxWidth" Value="140"/>
                <Setter Property="Padding" Value="2"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="Transparent"/>

                <!-- Триггер на ошибку валидации -->
                <Style.Triggers>
                    <Trigger Property="Validation.HasError" Value="True">
                        <Setter Property="BorderBrush" Value="Red"/>
                        <Setter Property="BorderThickness" Value="2"/>
                        <Setter Property="Background" Value="#FFF0F0"/>
                        <Setter Property="ToolTip"
                        Value="{Binding RelativeSource={RelativeSource Self},
                                        Path=(Validation.Errors)[0].ErrorContent}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Grid.Resources>
        <hc:TabControl Style="{StaticResource TabControlInLine}">
            <hc:TabItem Header="Датчики">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="{Binding StringFormat=Количество: {0},Path=Sensors.Count}"
                               Margin="5,0"
                               Grid.Row="0"/>
                    <Button Content="Валидные адреса"
                            Command="{Binding DoCurrentAddress}" Visibility="{Binding IsEditMode,Converter={StaticResource Bool2VisOrHidden}}"/>
                    <DataGrid ItemsSource="{Binding Sensors}" AutoGenerateColumns="False" CanUserAddRows="False"
          SelectedItem="{Binding SelectedMapObject}" Grid.Row="1"
          IsReadOnly="{Binding IsEditMode,Converter={StaticResource Boolean2BooleanReConverter}}">
                        <i:Interaction.Behaviors>
                            <beh:DataGridBahavior/>
                        </i:Interaction.Behaviors>
                        <DataGrid.Columns>
                            <DataGridComboBoxColumn DisplayMemberPath="Name"
                                MinWidth="100"
                                Header="Название"
                                TextBinding="{Binding Sensor.Name}">
                                <DataGridComboBoxColumn.EditingElementStyle>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="ItemsSource" Value="{Binding ElementName=root,Path=DataContext.SensorList,Mode=OneWay}"/>
                                        <EventSetter Event="SelectionChanged" Handler="SensorComboBox_SelectionChanged"/>
                                    </Style>
                                </DataGridComboBoxColumn.EditingElementStyle>
                            </DataGridComboBoxColumn>
                            <DataGridTextColumn MaxWidth="140"
                                                MinWidth="100"
                                                Header="Адрес">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="Address" UpdateSourceTrigger="LostFocus">
                                        <Binding.ValidationRules>
                                            <valid:InputDigitOnly/>
                                        </Binding.ValidationRules>
                                    </Binding>
                                </DataGridTextColumn.Binding>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource ValidatedCellStyle}"/>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding Description}"  Header="Описание">
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource DataGridEditingTextColumnStyle}">
                                        <Setter Property="Width" Value="auto"/>
                                        <Setter Property="MinWidth" Value="50"/>
                                        <Setter Property="MaxLength" Value="40"/>
                                        <Setter Property="MaxWidth" Value="170"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Изображение" IsReadOnly="True" CellTemplate="{StaticResource imgView_Button}"/>
                            <DataGridTemplateColumn Header="Действие">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Name="AddImage" Style="{StaticResource LoadImageButtonStyle}"
                            Command="{Binding Path=DataContext.AddImage,ElementName=root}"
                            CommandParameter="{Binding}">
                                            <Button.Content>
                                                <Image Source="{StaticResource CameraImage}"/>
                                            </Button.Content>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </hc:TabItem>
            <hc:TabItem Header="Устройства">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="{Binding StringFormat=Количество: {0},Path=Devices.Count}"
           Margin="5,0"
           Grid.Row="0"/>
                    <DataGrid ItemsSource="{Binding Devices}" AutoGenerateColumns="False" CanUserAddRows="False"
SelectedItem="{Binding SelectedMapObject}" Grid.Row="1"
IsReadOnly="{Binding IsEditMode,Converter={StaticResource Boolean2BooleanReConverter}}">
                        <i:Interaction.Behaviors>
                            <beh:DataGridBahavior/>
                        </i:Interaction.Behaviors>
                        <DataGrid.Columns>
                            <DataGridComboBoxColumn DisplayMemberPath="Name"
                                                    MinWidth="100"
                                                    Header="Название"
                                                    TextBinding="{Binding Device.Name}">
                                <DataGridComboBoxColumn.EditingElementStyle>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="ItemsSource" Value="{Binding ElementName=root,Path=DataContext.DeviceList,Mode=OneWay}"/>
                                        <EventSetter Event="SelectionChanged" Handler="SensorComboBox_SelectionChanged"/>
                                    </Style>
                                </DataGridComboBoxColumn.EditingElementStyle>
                            </DataGridComboBoxColumn>
                            <DataGridTextColumn Binding="{Binding Description}"  Header="Описание">
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource DataGridEditingTextColumnStyle}">
                                        <Setter Property="Width" Value="auto"/>
                                        <Setter Property="MinWidth" Value="50"/>
                                        <Setter Property="MaxLength" Value="40"/>
                                        <Setter Property="MaxWidth" Value="170"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Изображение" IsReadOnly="True" CellTemplate="{StaticResource imgView_Button}"/>
                            <DataGridTemplateColumn Header="Действие">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Name="AddImage" Style="{StaticResource LoadImageButtonStyle}"
                  Command="{Binding Path=DataContext.AddImage,ElementName=root}"
                  CommandParameter="{Binding}">
                                            <Button.Content>
                                                <Image Source="{StaticResource CameraImage}"/>
                                            </Button.Content>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </hc:TabItem>
        </hc:TabControl>
    </Grid>
</hc:Window>
