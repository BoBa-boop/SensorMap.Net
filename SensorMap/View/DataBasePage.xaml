<UserControl x:Class="SensorMap.View.DataBasePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:vm="clr-namespace:SensorMap.ViewModel"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SensorMap.View"
      mc:Ignorable="d" 
      xmlns:hc="https://handyorg.github.io/handycontrol"
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance vm:DataBasePageVM}">
    <UserControl.Resources>
        <Style x:Key="LogCellStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Error">
                    <Setter Property="Foreground" Value="#C62828"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Delete">
                    <Setter Property="Foreground" Value="#B26A00"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <GroupBox Style="{StaticResource GroupBoxOriginal}" Grid.Column="0"
          BorderThickness="1.5" Margin="8" BorderBrush="Transparent">
            <GroupBox.Header>
                <TextBlock Text="База данных" Style="{StaticResource TextBlockTitle}"
                   FontFamily="Bahnschrift"/>
            </GroupBox.Header>
            <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Margin="10,0">
                <TextBlock Text="Текущая База Данных"
                   Margin="0,5"
                   Style="{StaticResource TextBlockSubTitle}"/>
                <StackPanel Orientation="Vertical" HorizontalAlignment="Left">
                    <TextBlock Name="txtDB_Name"
                               Text="{Binding DbName}"
                               Width="auto"
                               MaxWidth="330"
                               Padding="7,5"
                               Background="WhiteSmoke"/>
                <StackPanel Orientation="Horizontal">
                    <Menu>
                        <MenuItem Header="Расположение файла"
                                  Command="{Binding NavigateToPathDB}">
                            <MenuItem.Icon>
                                <Image Source="{StaticResource DataBaseSearch2Image}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Загрузить другую БД"
                                  Command="{Binding ChangeDataBase}">
                            <MenuItem.Icon>
                                <Image Source="{StaticResource DataBaseLoadImage}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </Menu>
                </StackPanel>
                </StackPanel>
                <GroupBox Style="{StaticResource GroupBoxOriginalBaseStyle}"
                          HorizontalAlignment="Center" Background="{StaticResource BackgroundBrush}"
                          BorderThickness="2" BorderBrush="{StaticResource BorderBrush}">
                <StackPanel Orientation="Vertical" 
                            Visibility="{Binding ElementName=stepBar,Path=Visibility}">
                <TextBlock Text="Проверка выбранного файла" Style="{StaticResource TextBlockSubTitle}" FontWeight="Medium"/>
                <hc:StepBar ItemsSource="{Binding Steps}"
                            Visibility="{Binding Steps.Count,Converter={StaticResource CountToReVisibility}}"
                            x:Name="stepBar"
                            StepIndex="{Binding StepIndex}"
                            Dock="Left" 
                            Foreground="{DynamicResource DangerBrush}"
                            Margin="10">
                    <hc:StepBar.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                        <TextBlock FontSize="14" HorizontalAlignment="Left"
                                           Text="{Binding Title}" FontWeight="Medium">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="Foreground" Value="{StaticResource InfoBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding State}" Value="Ошибка">
                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="Ожидание">
                                                            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="Успешно">
                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                        </DataTemplate>
                    </hc:StepBar.ItemTemplate>
                            <hc:StepBar.ItemContainerStyle>
                                <Style TargetType="hc:StepBarItem" BasedOn="{StaticResource StepBarItemVertical}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="Успешно">
                                            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Ошибка">
                                            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Ожидание">
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </hc:StepBar.ItemContainerStyle>
                        </hc:StepBar>
                
                <TextBlock Text="{Binding CheckError}"
                           Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap" FontSize="16" FontWeight="Bold"
                           Margin="10"/>
                        <Button Content="Обновить Базу Данных" Margin="0,10,0,10"
                                Command="{Binding UpdateDataBaseMigration}"
                                Style="{StaticResource ButtonWarning}" Foreground="Black" FontSize="12"
                                Visibility="{Binding ShowUpdateDbButton,Converter={StaticResource Boolean2VisibilityConverter}}"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </GroupBox>
        <GroupBox Style="{StaticResource GroupBoxOriginal}"
                  Grid.Column="1" Margin="8">
            <GroupBox.Header>
                <TextBlock Text="Логи" Style="{StaticResource TextBlockTitle}"
                           FontFamily="Bahnschrift"/>
            </GroupBox.Header>
            <Grid Grid.Column="1" Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>

                <!-- Поиск и фильтр -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
                    <hc:SearchBar Width="220"
                      hc:InfoElement.Placeholder="Поиск по журналу"
                      Text="{Binding LogSearch, UpdateSourceTrigger=PropertyChanged}"/>
                    <CheckBox Content="Только ошибки" Margin="10,0,0,0" VerticalAlignment="Center"
                  IsChecked="{Binding OnlyErrors}"/>
                </StackPanel>

                <DataGrid Name="SQL_Journal" Grid.Row="1"
              ItemsSource="{Binding LogsView}"
              SelectedItem="{Binding SelectedLog}"
              AutoGenerateColumns="False"
              IsReadOnly="True" VerticalScrollBarVisibility="Visible"
              Style="{StaticResource DataGrid.Small}">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Копировать" Command="{Binding CopyLog}"/>
                            <MenuItem Header="Показать полностью" Command="{Binding ShowFullLog}"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Дата"
                                Binding="{Binding Timestamp, StringFormat={}{0:dd.MM.yyyy HH:mm:ss}}"
                                Width="140" ElementStyle="{StaticResource LogCellStyle}"/>
                        <DataGridTextColumn Header="Действие" Binding="{Binding KindText}"
                                Width="95" ElementStyle="{StaticResource LogCellStyle}"/>
                        <DataGridTextColumn Header="Описание" Binding="{Binding Description}"
                                Width="*" ElementStyle="{StaticResource LogCellStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Button Content="Загрузить еще" Grid.Row="2"
            VerticalAlignment="Bottom"
            Command="{Binding LoadMoreLogs}"
            Visibility="{Binding CanLoadMore, Converter={StaticResource Bool2VisOrHidden}}"/>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
