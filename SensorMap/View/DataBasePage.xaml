<UserControl x:Class="SensorMap.View.DataBasePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:vm="clr-namespace:SensorMap.ViewModel"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SensorMap.View"
      mc:Ignorable="d" 
      xmlns:hc="https://handyorg.github.io/handycontrol"
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance vm:DataBasePageVM}">
    <UserControl.Resources>
        <Style x:Key="LogCellStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Error">
                    <Setter Property="Foreground" Value="#C62828"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Delete">
                    <Setter Property="Foreground" Value="#B26A00"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <GroupBox Style="{StaticResource GroupBoxOriginal}" Grid.Column="0"
          BorderThickness="1.5" Margin="8" BorderBrush="LightGray">
            <GroupBox.Header>
                <TextBlock Text="База данных" Style="{StaticResource TextBlockDefault}"
                   FontFamily="Bahnschrift" FontSize="17"/>
            </GroupBox.Header>
            <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Margin="10">
                <TextBlock Text="Загрузить новую БД"
                   HorizontalAlignment="Left"
                   Margin="0,5"
                   Style="{StaticResource TextBlockSubTitle}"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Name="txtDB_Name"
                       Text="{Binding DbName}"
                       Width="200"
                       Padding="7,5"
                       Background="WhiteSmoke"/>
                    <Button Width="35" Style="{StaticResource ButtonInfo}"
                    Cursor="Hand"
                    hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                    Command="{Binding ChangeDataBase}"/>
                </StackPanel>
                <TextBlock Text="{Binding DbPath,UpdateSourceTrigger=PropertyChanged}"
                   TextTrimming="WordEllipsis"
                   Cursor="Hand"
                   ToolTip="{Binding DbPath,UpdateSourceTrigger=PropertyChanged}"
                   Padding="7,5"
                   MaxWidth="240"                           
                   Background="Transparent">
                    <TextBlock.InputBindings>
                        <MouseBinding Gesture="LeftClick" Command="{Binding NavigateToPathDB}"/>
                    </TextBlock.InputBindings>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <Trigger Property="TextBlock.IsMouseOver" Value="True">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </GroupBox>
        <GroupBox Style="{StaticResource GroupBoxOriginal}"
                  Grid.Column="1" Margin="8">
            <GroupBox.Header>
                <TextBlock Text="Логи" Style="{StaticResource TextBlockDefault}"
                           FontFamily="Bahnschrift" FontSize="17"/>
            </GroupBox.Header>
            <Grid Grid.Column="1" Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>

                <!-- Поиск и фильтр -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
                    <hc:SearchBar Width="220"
                      hc:InfoElement.Placeholder="Поиск по журналу"
                      Text="{Binding LogSearch, UpdateSourceTrigger=PropertyChanged}"/>
                    <CheckBox Content="Только ошибки" Margin="10,0,0,0" VerticalAlignment="Center"
                  IsChecked="{Binding OnlyErrors}"/>
                </StackPanel>

                <DataGrid Name="SQL_Journal" Grid.Row="1"
              ItemsSource="{Binding LogsView}"
              SelectedItem="{Binding SelectedLog}"
              AutoGenerateColumns="False"
              IsReadOnly="True" VerticalScrollBarVisibility="Visible"
              Style="{StaticResource DataGrid.Small}">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Копировать" Command="{Binding CopyLog}"/>
                            <MenuItem Header="Показать полностью" Command="{Binding ShowFullLog}"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Дата"
                                Binding="{Binding Timestamp, StringFormat={}{0:dd.MM.yyyy HH:mm:ss}}"
                                Width="140" ElementStyle="{StaticResource LogCellStyle}"/>
                        <DataGridTextColumn Header="Действие" Binding="{Binding KindText}"
                                Width="95" ElementStyle="{StaticResource LogCellStyle}"/>
                        <DataGridTextColumn Header="Описание" Binding="{Binding Description}"
                                Width="*" ElementStyle="{StaticResource LogCellStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Button Content="Загрузить еще" Grid.Row="2"
            VerticalAlignment="Bottom"
            Command="{Binding LoadMoreLogs}"
            Visibility="{Binding CanLoadMore, Converter={StaticResource Bool2VisOrHidden}}"/>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
